# ORIGIN AI Workspace - Docker Compose / NAS
APP_ENV=production
APP_NAME=ORIGIN AI Workspace
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api

# Browser requests stay on the current host and are proxied by Nginx.
NEXT_PUBLIC_API_URL=/api

# Required. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Docker services
POSTGRES_USER=origin
POSTGRES_PASSWORD=
POSTGRES_DB=origin_ai
# Docker Compose constructs DATABASE_URL from POSTGRES_* and injects it into the API container.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# AI Providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
