# ORIGIN AI Workspace
APP_ENV=development
APP_NAME=ORIGIN AI Workspace
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security
JWT_SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
POSTGRES_USER=origin
POSTGRES_PASSWORD=origin_password
POSTGRES_DB=origin_ai
DATABASE_URL=postgresql+asyncpg://origin:origin_password@postgres:5432/origin_ai

# Redis
REDIS_URL=redis://redis:6379/0

# AI Providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
