{
  "python.analysis.extraPaths": ["${workspaceFolder}/apps/api"],
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/api/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests/", "-v"],
  "python.testing.cwd": "${workspaceFolder}/apps/api",
  "typescript.tsdk": "${workspaceFolder}/apps/web/node_modules/typescript/lib",
  "eslint.workingDirectories": ["apps/web"],
  "search.exclude": {
    "**/.next": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/node_modules": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  }
}
