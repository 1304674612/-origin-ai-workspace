# ORIGIN AI Workspace - local development
APP_ENV=development
APP_NAME=ORIGIN AI Workspace
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Browser requests stay same-origin through Next.js rewrites.
NEXT_PUBLIC_API_URL=/api
ORIGIN_API_URL=http://localhost:8000

# Required. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
# Required. Separate from JWT_SECRET_KEY so rotating JWT does not invalidate stored API keys.
APP_ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local services
POSTGRES_USER=origin
POSTGRES_PASSWORD=origin_password
POSTGRES_DB=origin_ai
DATABASE_URL=postgresql+asyncpg://origin:origin_password@localhost:5432/origin_ai
REDIS_URL=redis://localhost:6379/0

# AI Providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
